# ============================================================================
# Supabase 凭证（启用手机/电脑云端数据同步需要）
# ----------------------------------------------------------------------------
# 获取方式：Supabase 控制台 → 你的项目 → Project Settings → API
#   - Project URL     → 填到下面的 VITE_SUPABASE_URL
#   - anon public key → 填到下面的 VITE_SUPABASE_ANON_KEY
#
# 把本文件复制为 .env（同级目录），填入真实值后重启应用即可开启云端同步。
# 若不填 / 不创建 .env，应用以「纯本地模式」运行：数据只存在本机，不同步。
# ============================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
